# Feishu app credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Codex defaults
DEFAULT_MODEL=gpt-5.5
DEFAULT_CWD=~

# Modes:
#   plan      - safest public default, planning only
#   workspace - automatic execution inside the workspace sandbox
#   danger    - passes --dangerously-bypass-approvals-and-sandbox
#
# WARNING: danger lets Feishu messages trigger local command execution and file edits.
DEFAULT_MODE=plan

# Optional Codex CLI path. Leave unset to resolve from PATH.
# CODEX_CLI_PATH=/usr/local/bin/codex

CALLBACK_PORT=9982
STREAM_CHUNK_SIZE=20
