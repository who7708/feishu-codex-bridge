# Feishu app credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional user allowlist. Empty/unset allows everyone; otherwise only listed open_id values can use the bot.
# ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx,ou_yyyyyyyyyyyyyyyy

# Codex defaults
DEFAULT_MODEL=gpt-5.5
DEFAULT_CWD=~

# Optional ticket database profile directory. Defaults to DEFAULT_CWD.
# TICKET_DB_CONFIG_DIR=

# Modes:
#   plan      - safest public default, planning only
#   workspace - write access inside the workspace sandbox
#   danger    - passes --dangerously-bypass-approvals-and-sandbox
#
# WARNING: danger lets Feishu messages trigger local command execution and file edits.
DEFAULT_MODE=plan

# Optional Codex CLI path. Leave unset to resolve from PATH.
# CODEX_CLI_PATH=/usr/local/bin/codex

CALLBACK_PORT=9982
STREAM_CHUNK_SIZE=20
IDLE_TIMEOUT=600
CODEX_IDLE_TIMEOUT=900

# 默认只记处理阶段、耗时和文本长度；设为 true 会在控制台输出截断后的对话内容，注意本机日志访问权限。
LOG_CONVERSATION_CONTENT=true
